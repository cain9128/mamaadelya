VITE_SUPABASE_URL=https://<ваш-проект>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-ключ из Dashboard -> Settings -> API>
VITE_OPENROUTER_API_KEY=<ключ OpenRouter>
VITE_YM_COUNTER_ID=<номер счётчика Яндекс.Метрики, например 12345678>

# Robokassa (задаются как секреты Supabase Edge Functions, НЕ в Vite-окружении):
# supabase secrets set ROBOKASSA_LOGIN=<логин магазина из ЛК>
# supabase secrets set ROBOKASSA_PASSWORD1=<Пароль #1 из тех. настроек ЛК>
# supabase secrets set ROBOKASSA_PASSWORD2=<Пароль #2 из тех. настроек ЛК>
# supabase secrets set ROBOKASSA_IS_TEST=true   (false — для боевого режима)
# supabase secrets set ROBOKASSA_SUCCESS_URL=https://previewgen.ru/profile?payment=success
